{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JN Decision Schema v3.1",
  "type": "object",
  "required": [
    "jn_schema_version",
    "brand",
    "renderer_mode",
    "complexity",
    "question_title",
    "question_subtitle",
    "executive",
    "real_question",
    "key_conflicts",
    "value_chain",
    "next_actions",
    "reversal_conditions"
  ],
  "properties": {
    "jn_schema_version": {"const": "3.1"},
    "brand": {"const": "JN 企业价值引擎"},
    "renderer_mode": {"enum": ["FAST", "FULL"]},
    "complexity": {
      "type": "object",
      "required": ["level", "capital", "reversibility", "uncertainty", "strategic_coupling"],
      "properties": {
        "level": {"enum": ["LEVEL_1", "LEVEL_2", "LEVEL_3"]},
        "capital": {"type": "string"},
        "reversibility": {"type": "string"},
        "uncertainty": {"type": "string"},
        "strategic_coupling": {"type": "string"},
        "modules_skipped": {"type": "array", "items": {"type": "string"}}
      }
    },
    "question_title": {"type": "string", "maxLength": 36},
    "question_subtitle": {"type": "string", "maxLength": 80},
    "executive": {
      "type": "object",
      "required": ["decision", "status", "confidence", "core_principle"],
      "properties": {
        "decision": {"type": "string", "maxLength": 120},
        "status": {"enum": ["GO", "CONDITIONAL_GO", "PILOT", "HOLD", "NO_GO", "EXIT", "NEED_MORE_EVIDENCE"]},
        "confidence": {"enum": ["高", "中高", "中", "低"]},
        "core_principle": {"type": "string", "maxLength": 60}
      }
    },
    "real_question": {
      "type": "object",
      "required": ["surface", "actual"],
      "properties": {
        "surface": {"type": "string"},
        "actual": {"type": "string"}
      }
    },
    "strategic_context": {
      "type": "object",
      "properties": {
        "lifecycle": {"type": ["string", "null"]},
        "track": {"type": ["string", "null"]},
        "position": {"type": ["string", "null"]},
        "business_model": {"type": ["string", "null"]},
        "objective": {"type": ["string", "null"]}
      }
    },
    "number_quality": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "metric": {"type": "string"},
          "amount": {"type": ["string", "null"]},
          "composition": {"type": ["string", "null"]},
          "quality": {"type": ["string", "null"]},
          "sustainability": {"type": ["string", "null"]},
          "value_consequence": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_gate": {
      "type": "object",
      "properties": {
        "material_unknowns": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
        "decision_is_conditional": {"type": "boolean"},
        "condition_tree": {"type": "array", "maxItems": 3, "items": {"type": "string"}}
      }
    },
    "redesign": {
      "type": "object",
      "properties": {
        "material": {"type": "boolean"},
        "current_system_problem": {"type": ["string", "null"]},
        "redesign_option": {"type": ["string", "null"]},
        "materiality_reason": {"type": ["string", "null"]},
        "who_bears_what": {
          "type": "object",
          "properties": {
            "owner": {"type": ["string", "null"]},
            "user": {"type": ["string", "null"]},
            "funder": {"type": ["string", "null"]},
            "risk_bearer": {"type": ["string", "null"]},
            "return_receiver": {"type": ["string", "null"]}
          }
        }
      }
    },
    "forecast_mode": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["FORWARD", "MILESTONE", "ENDGAME", "NOT_APPLICABLE"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "key_conflicts": {"type": "array", "minItems": 1, "maxItems": 3},
    "current_situation": {"type": "array", "maxItems": 5},
    "options": {"type": "array", "minItems": 2, "maxItems": 3},
    "option_ranking": {"type": ["string", "null"]},
    "value_chain": {"type": "array", "minItems": 3, "maxItems": 6},
    "roadmap": {"type": "array", "minItems": 1, "maxItems": 3},
    "metrics": {"type": "array", "maxItems": 5},
    "decision_gates": {"type": "array", "maxItems": 4},
    "next_actions": {"type": "array", "minItems": 1, "maxItems": 4},
    "reversal_conditions": {"type": "array", "minItems": 1, "maxItems": 4},
    "risks_and_boundaries": {"type": "array", "maxItems": 4}
  },
  "allOf": [
    {
      "if": {"properties": {"renderer_mode": {"const": "FULL"}}},
      "then": {
        "required": ["options", "option_ranking", "roadmap", "metrics", "decision_gates"]
      }
    }
  ]
}
